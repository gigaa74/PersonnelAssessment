APP_DEBUG=0
APP_SECRET_KEY=replace-with-at-least-50-random-characters
APP_ALLOWED_HOSTS=assessment.example.com
CSRF_TRUSTED_ORIGINS=https://assessment.example.com
DATABASE_URL=postgresql://user:password@host:5432/database
ADMIN_USERNAME=admin
ADMIN_EMAIL=director@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=assessment@example.com
